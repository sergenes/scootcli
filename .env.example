# scoot reads two optional .env files:
#   ~/.config/scoot/.env          global: the stable place for API keys (chmod 600 it)
#   the nearest .env walking up   project: found from any subdirectory of a repo
# Only these keys are imported: SCOOT_*, provider API keys, HTTPS_PROXY / NO_PROXY.
# Everything else in a project .env is ignored, and real environment variables always win.
#
#   cp .env.example ~/.config/scoot/.env && chmod 600 ~/.config/scoot/.env

# ── Provider API keys (Ollama needs none). Alternative: `scoot auth set openai` ──
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here     (arrives in 0.2.0)

# ── Default provider and model ────────────────────────────────────────────────
# Default provider: the first with a key, else ollama. Models are provider/model.
# SCOOT_PROVIDER=openai
# SCOOT_MODEL=openai/gpt-5.3-codex
# SCOOT_EFFORT=medium                        # low | medium | high | xhigh (reasoning models)
# SCOOT_VISION_MODEL=auto                    # provider/model for image descriptions

# ── Endpoints ─────────────────────────────────────────────────────────────────
# SCOOT_OPENAI_BASE_URL=https://api.openai.com/v1
# SCOOT_OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Behaviour ─────────────────────────────────────────────────────────────────
# SCOOT_APPROVAL=yolo                        # always | auto-read | auto-edits | yolo
# SCOOT_MAX_STEPS=50
# SCOOT_COMPACT_AT=100000
# SCOOT_TIMEOUT=120
# SCOOT_RESUME=auto                          # auto | hint | off
# SCOOT_VERBOSITY=full                       # full | compact | quiet
# SCOOT_LOGO=1
# SCOOT_EMOJI=1

# ── Network ───────────────────────────────────────────────────────────────────
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
